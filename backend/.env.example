# Clarity Backend — Configuration
# Copy to .env and fill in values.

# API security — optional bearer token. When empty, the API is unauthenticated.
CLARITY_API_TOKEN=

# Search backends — configure at least one production discovery provider.
# BLS CPI for US inflation claims is built in and needs no key.
CLARITY_DDG_ENABLED=true
# Recommended: Brave Search API (broad discovery; results are still validated)
# CLARITY_BRAVE_SEARCH_API_KEY=your_brave_key_here
# Alternative: SerpAPI Google engine
# CLARITY_SERPAPI_KEY=your_serpapi_key_here
# Alternative: Google Programmable Search
# CLARITY_GOOGLE_API_KEY=your_key_here
# CLARITY_GOOGLE_CSE_ID=your_cse_id_here

# LLM provider — any OpenAI-compatible Chat Completions endpoint.
# Presets: openai, deepseek, groq, openrouter, together, mistral, xai,
#          perplexity, ollama, lmstudio, llamacpp, vllm, bifrost, custom.
# MODEL is required to enable the LLM; leave it empty to run the
# deterministic evaluator (all verdicts Unverified unless classified).
CLARITY_LLM_ENABLED=true
CLARITY_LLM_PROVIDER=openai
CLARITY_LLM_API_KEY=
CLARITY_LLM_MODEL=
# CLARITY_LLM_BASE_URL=            # overrides the preset; required for custom
# CLARITY_LLM_EXTRA_HEADERS={}     # JSON object (e.g. OpenRouter attribution)
# CLARITY_LLM_MAX_TOKENS_PARAM=max_tokens   # or max_completion_tokens
CLARITY_LLM_TIMEOUT=30

# Evidence fetching
CLARITY_MAX_SOURCES=8
CLARITY_MAX_PASSAGE=600
CLARITY_FETCH_TIMEOUT=10

# Rate limiting
CLARITY_RATE_LIMIT=10
CLARITY_RATE_LIMIT_HOUR=50

# Cache
CLARITY_CACHE_TTL=1800

# CORS
CLARITY_CORS_ORIGINS=chrome-extension://*