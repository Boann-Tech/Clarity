# Clarity Backend — Configuration
# Copy to .env and fill in values.

# Host / Port
CLARITY_HOST=0.0.0.0
CLARITY_PORT=8080
CLARITY_DEBUG=false

# Search backends — configure at least one:
# 1) DuckDuckGo (free, rate-limited, enabled by default)
CLARITY_DDG_ENABLED=true

# 2) Google Custom Search (recommended — 100 free queries/day)
# Get API key: https://console.cloud.google.com/apis/credentials
# Get CSE ID: https://cse.google.com/cse/all
# CLARITY_GOOGLE_API_KEY=your_key_here
# CLARITY_GOOGLE_CSE_ID=your_cse_id_here

# 3) SerpAPI (alternative)
# CLARITY_SERPAPI_KEY=your_key_here

# Evidence fetching
CLARITY_MAX_SOURCES=8
CLARITY_MAX_PASSAGE=600
CLARITY_FETCH_TIMEOUT=10

# LLM (optional — for claim normalization & evidence synthesis)
# CLARITY_OPENAI_API_KEY=sk-...
# CLARITY_OPENAI_MODEL=gpt-4o-mini

# Rate limiting
CLARITY_RATE_LIMIT=10
CLARITY_RATE_LIMIT_HOUR=50

# Cache
CLARITY_CACHE_TTL=1800

# CORS — comma-separated origins
CLARITY_CORS_ORIGINS=chrome-extension://*