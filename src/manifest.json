{
  "manifest_version": 3,
  "name": "Clarity — Evidence for what you read.",
  "version": "0.1.0",
  "description": "Checks factual claims in articles and YouTube captions against authoritative sources. Fights misinformation by showing evidence, not telling you what to believe.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*", "https://*/*"],
      "js": ["content/extractor.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "action": {
    "default_title": "Clarity — Check claims on this page"
  },
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}